{
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,integrations.py,data/content-plan-v3.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/go/:path*",
      "destination": "/api/index?__path=/go/:path*"
    },
    {
      "source": "/hooks/:path*",
      "destination": "/api/index?__path=/hooks/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
